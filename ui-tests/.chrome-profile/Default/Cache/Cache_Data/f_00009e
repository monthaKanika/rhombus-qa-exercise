 miss_status,\n    -- Age stats\n    MIN(age_num) AS age_min,\n    MAX(age_num) AS age_max,\n    AVG(age_num) AS age_avg,\n    -- Amount stats\n    MIN(amount_num) AS amount_min,\n    MAX(amount_num) AS amount_max,\n    AVG(amount_num) AS amount_avg,\n    SUM(amount_num) AS amount_total,\n    -- Unusual: negative amounts\n    SUM(CASE WHEN amount_num < 0 THEN 1 ELSE 0 END) AS negative_amounts,\n    -- Unusual: zero amounts\n    SUM(CASE WHEN amount_num = 0 THEN 1 ELSE 0 END) AS zero_amounts,\n    -- Unusual: invalid age (<=0 or >120)\n    SUM(CASE WHEN age_num <= 0 OR age_num > 120 THEN 1 ELSE 0 END) AS invalid_age,\n    -- Duplicate order_ids\n    COUNT(*) - COUNT(DISTINCT order_id) AS duplicate_order_ids,\n    -- Invalid date parse\n    SUM(CASE WHEN order_date IS NOT NULL AND TRIM(order_date) != '' AND order_date_parsed IS NULL THEN 1 ELSE 0 END) AS invalid_dates,\n    -- Name casing inconsistency count\n    SUM(CASE WHEN customer_name = UPPER(customer_name) THEN 1 ELSE 0 END) AS all_caps_names,\n    SUM(CASE WHEN customer_name = LOWER(customer_name) THEN 1 ELSE 0 END) AS all_lower_names,\n    -- Email without @\n    SUM(CASE WHEN email NOT LIKE '%@%' AND email IS NOT NULL AND TRIM(email) != '' THEN 1 ELSE 0 END) AS invalid_emails,\n    -- Date range\n    MIN(order_date_parsed) AS date_min,\n    MAX(order_date_parsed) AS date_max\n  FROM base\n),\nstatus_counts AS (\n  SELECT status, COUNT(*) AS cnt FROM base GROUP BY status\n),\ncountry_counts AS (\n  SELECT country, COUNT(*) AS cnt FROM base GROUP BY country ORDER BY cnt DESC\n),\nmonthly AS (\n  SELECT DATE_TRUNC('month', order_date_parsed) AS month, COUNT(*) AS orders, SUM(amount_num) AS revenue\n  FROM base WHERE order_date_parsed IS NOT NULL\n  GROUP BY 1 ORDER BY 1\n),\namount_buckets AS (\n  SELECT\n    CASE\n      WHEN amount_num < 0 THEN 'Negative'\n      WHEN amount_num = 0 THEN 'Zero'\n      WHEN amount_num < 50 THEN '0-50'\n      WHEN amount_num < 100 THEN '50-100'\n      WHEN amount_num < 200 THEN '