T order_id) AS duplicate_order_ids,\n  SUM(CASE WHEN order_date IS NOT NULL AND TRIM(order_date)!='' AND order_date_parsed IS NULL THEN 1 ELSE 0 END) AS invalid_dates,\n  SUM(CASE WHEN customer_name = UPPER(customer_name) THEN 1 ELSE 0 END) AS all_caps_names,\n  SUM(CASE WHEN customer_name = LOWER(customer_name) THEN 1 ELSE 0 END) AS all_lower_names,\n  SUM(CASE WHEN email NOT LIKE '%@%' AND email IS NOT NULL AND TRIM(email)!='' THEN 1 ELSE 0 END) AS invalid_emails,\n  CAST(MIN(order_date_parsed) AS varchar) AS date_min,\n  CAST(MAX(order_date_parsed) AS varchar) AS date_max\nFROM base\n\"\"\"\n\nsql_status = \"SELECT status, COUNT(*) AS cnt FROM source GROUP BY status ORDER BY cnt DESC\"\nsql_country = \"SELECT country, COUNT(*) AS cnt FROM source GROUP BY country ORDER BY cnt DESC\"\nsql_monthly = \"\"\"\nSELECT DATE_FORMAT(try_cast(order_date AS date), '%Y-%m') AS month,\n       COUNT(*) AS orders,\n       ROUND(SUM(try_cast(amount_usd AS double)),2) AS revenue\nFROM source\nWHERE try_cast(order_date AS date) IS NOT NULL\nGROUP BY 1 ORDER BY 1\n\"\"\"\nsql_buckets = \"\"\"\nSELECT\n  CASE\n    WHEN try_cast(amount_usd AS double) < 0 THEN 'Negative'\n    WHEN try_cast(amount_usd AS double) = 0 THEN 'Zero'\n    WHEN try_cast(amount_usd AS double) < 50 THEN '0-50'\n    WHEN try_cast(amount_usd AS double) < 100 THEN '50-100'\n    WHEN try_cast(amount_usd AS double) < 200 THEN '100-200'\n    WHEN try_cast(amount_usd AS double) < 500 THEN '200-500'\n    ELSE '500+'\n  END AS bucket,\n  COUNT(*) AS cnt\nFROM source GROUP BY 1\n\"\"\"\nsql_status_amount = \"\"\"\nSELECT status, ROUND(AVG(try_cast(amount_usd AS double)),2) AS avg_amount, COUNT(*) AS cnt\nFROM source GROUP BY status ORDER BY cnt DESC\n\"\"\"\n\nt = query_sources(source, sql)\nstatus_df = query_sources(source, sql_status)\ncountry_df = query_sources(source, sql_country)\nmonthly_df = query_sources(source, sql_monthly)\nbucket_df = query_sources(source, sql_buckets)\nstatus_amt_df = query_sources(source, sql